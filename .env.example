PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/secure_connect
# Used only by `npm test`. The database name MUST contain "test" (it gets wiped).
MONGO_URI_TEST=mongodb://127.0.0.1:27017/secure_connect_test

# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Used ONLY by `npm run create-admin`. Use a private address you control and a
# strong password, then delete ADMIN_PASSWORD from .env after seeding.
# Public signup can never create an admin.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
